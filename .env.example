# Copy to .env next to docker-compose.yml and fill in. See docs/DEPLOY.md.

# The domain players visit, pointed at this server (an A record). Caddy gets its certificate.
DOMAIN=splitsignal.example.com
# Where Let's Encrypt sends certificate expiry warnings.
ACME_EMAIL=you@example.com

# Optional: Google sign-in and stats. A Web OAuth client ID whose authorized JavaScript origins
# include https://<DOMAIN>. Leave empty and everyone plays as a guest.
SPLIT_SIGNAL_GOOGLE_CLIENT_ID=

# Optional: STUN/TURN servers for voice, as JSON. The default is a public STUN server only, which
# is enough for most home networks. With the bundled TURN relay, use something like:
# SPLIT_SIGNAL_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":["turn:splitsignal.example.com:3478?transport=udp","turn:splitsignal.example.com:3478?transport=tcp"],"username":"splitsignal","credential":"change-me"}]
SPLIT_SIGNAL_ICE_SERVERS=

# Only for the optional TURN relay (docker compose --profile turn up -d).
# On EC2: public IP / private IP, e.g. 203.0.113.10/172.31.5.20
TURN_EXTERNAL_IP=
TURN_USER=splitsignal
TURN_PASSWORD=
